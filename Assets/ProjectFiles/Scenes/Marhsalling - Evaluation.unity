    showContinueButtonAfterAudio: 1
    hasQuiz: 1
    quizData:
      questionText: "right arm out at 90\xB0, right hand beckoning \u201Ccome ahead.\u201D
        Which signal did you just see?"
      options:
      - optionText: Turn Right
        isCorrect: 1
      - optionText: 'Straight Ahead '
        isCorrect: 0
      - optionText: Turn Left
        isCorrect: 0
