  - pageLabel: Intro
    targetGameObject: {fileID: 2017729314}
    titleComponent: {fileID: 0}
    titleContent: 
    textComponent: {fileID: 1394834410}
    textContent: 'Read the signal. Guide the aircraft.


      No radio. No headset.
      Just hands, wands, and a code every ground crew understands. Ready to learn
      it?'
    enableUIPop: 0
    popOrigin: 0
    useTypewriterEffect: 1
