  - pageLabel: Scene 5
    targetGameObject: {fileID: 2074956067}
    titleComponent: {fileID: 1772043988}
    titleContent: 'Straight Ahead '
    textComponent: {fileID: 1562095088}
    textContent: "This is one of the \u201Ccontinuous\u201D signals it doesn't mean
      anything as a single freeze-frame, the repetition is the message."
    enableUIPop: 1
    popOrigin: 1
    useTypewriterEffect: 1
    typingSpeed: 0.05
