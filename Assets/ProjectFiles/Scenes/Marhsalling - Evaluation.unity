  - pageLabel: Scene 6
    targetGameObject: {fileID: 2074956067}
    titleComponent: {fileID: 1772043988}
    titleContent: Normal Stop
    textComponent: {fileID: 1562095088}
    textContent: 'Watch the pace on screen: a slow, controlled sweep is what separates
      a routine stop from an emergency one'
    enableUIPop: 1
    popOrigin: 1
    useTypewriterEffect: 1
    typingSpeed: 0.05
