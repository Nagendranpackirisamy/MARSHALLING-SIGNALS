  - pageLabel: Scene 4
    targetGameObject: {fileID: 2074956067}
    titleComponent: {fileID: 1772043988}
    titleContent: Turn Right
    textComponent: {fileID: 1562095088}
    textContent: "Turn Left and Turn Right share the same extended arm, learners
      often mix them up \u2014 this is a great spot for a side-by-side comparison
      card in the library."
    enableUIPop: 1
    popOrigin: 1
    useTypewriterEffect: 1
    typingSpeed: 0.05
    playVoiceOver: 1
    voiceClips:
